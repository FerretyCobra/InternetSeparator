<Window x:Class="InternetSeparator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internet Separator" Height="520" Width="900" FontSize="13" Icon="app.ico"
        Closing="Window_Closing" Closed="Window_Closed">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Default for other apps:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DefaultBox" Width="160" SelectionChanged="DefaultBox_SelectionChanged"/>
            <Button Content="Add app…" Click="AddApp_Click" Padding="12,2" Margin="12,0,0,0"
                    ToolTip="List an app that isn't running yet, so you can choose its connection before starting it"/>
            <CheckBox x:Name="AutostartBox" Content="Start with Windows" VerticalAlignment="Center" Margin="12,0,0,0"
                      Click="Autostart_Click" ToolTip="Starts minimized at sign-in and applies your saved pins"/>
            <Button Content="About" Click="About_Click" Padding="12,2" Margin="12,0,0,0"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Tick apps, then click ⇄ to move them to the other side." VerticalAlignment="Center" Foreground="Gray"/>
            <Button Content="Follow default" Click="Unpin_Click" Padding="12,4" Margin="12,0,0,0"
                    ToolTip="Unpin the ticked apps; they use the default connection"/>
        </StackPanel>

        <ItemsControl x:Name="Columns">
            <ItemsControl.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            </ItemsControl.Resources>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="4,0">
                        <!-- Sits between this column and the one to its left -->
                        <Button DockPanel.Dock="Left" Content="⇄" FontSize="20" Width="40" Height="40" Margin="0,0,8,0"
                                VerticalAlignment="Center" Click="Swap_Click" ToolTip="Move the ticked apps to the other side"
                                Visibility="{Binding HasLeft, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" Margin="2,0,0,6"/>
                        <Border BorderBrush="#ABADB3" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Apps}" Margin="4,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Speed}" Foreground="Gray" Margin="8,0,0,0"/>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" Click="Check_Click" VerticalContentAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
